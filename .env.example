# ------------------------------------------------------------------
# Sildel production template (cPanel shared hosting). See DEPLOY.md.
# Copy to .env and fill in the values marked CHANGE.
# ------------------------------------------------------------------

APP_NAME=Sildel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the public address, https and no trailing slash
APP_URL=https://sildel.pt
# Leave empty unless assets are served from a different domain/CDN
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# CHANGE: cPanel > MySQL Databases (cPanel prefixes names with your account, e.g. acct_sildel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=acct_sildel
DB_USERNAME=acct_sildel
DB_PASSWORD=

# Shared hosting: no Redis, no queue worker
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# CHANGE: cPanel > Email Accounts > Connect Devices (SSL/TLS settings)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.sildel.pt
MAIL_PORT=465
MAIL_USERNAME=no-reply@sildel.pt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@sildel.pt"
MAIL_FROM_NAME="${APP_NAME}"

# Inbox that receives website enquiries
SILDEL_ENQUIRY_TO=sildel@sildel.pt

# One-time web installer for hosts WITHOUT terminal access (DEPLOY.md step 6).
# Set a long random value, visit /install?token=VALUE once, then clear it.
INSTALL_TOKEN=

VITE_APP_NAME="${APP_NAME}"
